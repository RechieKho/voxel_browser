# voxel_browser_server configuration. Copy to `server.toml` (next to the binary
# or pass --config <path>). Every key is optional; the values below are the
# built-in defaults. CLI flags override the file.

bind_address       = "0.0.0.0"
port               = 27015
content_pack       = "content/base"
max_players        = 16
view_distance      = 4          # chunks
tick_rate          = 20         # Hz, clamped to 1..240
world_seed         = 0          # 0 = random each startup
gravity            = 24.0
void_kill_y        = -64.0      # fall below this Y -> instant death, respawn at spawn
day_length_seconds = 1200.0     # real seconds per in-game day/night cycle
asset_max_file_mb  = 32
asset_max_total_mb = 512
max_connections_per_ip = 0      # 0 = unlimited; only bites over real UDP (VB_WITH_NET)
auth_mode          = "none"     # "none" | "token" (token verification is stubbed)
motd               = ""
persist_world      = true       # false = never touch disk, in-memory-only world (prior behavior)
world_dir          = "world"    # relative to the server's working directory, like content_pack
autosave_interval_seconds = 60.0 # 0 disables periodic autosave (unload/shutdown still save)
