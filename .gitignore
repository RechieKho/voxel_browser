build
build*/

.vscode/*
!.vscode/extensions.json

*.local
**/*.local

compile_commands.json

# Local runtime config (keep the .example templates).
/server.toml
/client.toml

# vb.storage's JSON backing file (Phase 4.2) -- runtime state, not content.
# `**` so this also covers nested demo packs (content/examples/<pack>/...,
# Phase 6.15), not just content/<pack>/ directly.
content/**/storage.json
# vb.db's per-key store (Phase 6.4) -- same "runtime state, not content"
# reasoning, content-addressed by sha256(key) under this directory.
content/**/db/

.cache/*

# End-to-end test artifacts (logs/traces of failed runs) and Python caches.
tests/e2e/artifacts/
tests/e2e/.pytest_cache/
__pycache__/
